# ==============================================================================
# Classroom Edu - Cấu hình biến môi trường mẫu (Local Development)
# ==============================================================================
# Chú ý: Các giá trị dưới đây là cấu hình mặc định để chạy thử nghiệm ở môi trường
# local dev với docker-compose (PostgreSQL, SeaweedFS (S3 API), Mailpit).
# KHÔNG SỬ DỤNG CÁC GIÁ TRỊ MẪU NÀY CHO MÔI TRƯỜNG PRODUCTION!
# Copy file này thành .env để sử dụng: cp .env.example .env
# ==============================================================================

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/classroom_edu"

# Application URL
APP_URL="http://localhost:3000"

# S3 / SeaweedFS (S3 API) Storage. Production (Cloudflare R2): S3_REGION="auto", S3_FORCE_PATH_STYLE="true"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="classroom-edu-dev"
S3_ACCESS_KEY_ID="devaccesskey"
S3_SECRET_ACCESS_KEY="devsecretkey"
S3_FORCE_PATH_STYLE="true"

# Email / Mailpit (Local SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
EMAIL_FROM="Classroom Edu <no-reply@classroom.edu.vn>"
# Bắt GV xác minh email trước khi đăng nhập. Mặc định tắt: đăng ký xong vào thẳng app.
# Chỉ bật ("true") khi đã có SMTP gửi được mail thật.
REQUIRE_EMAIL_VERIFICATION="false"
# GV tự đăng ký phải chờ admin duyệt ở /admin. Email đúng các tên miền này (cách nhau bằng dấu phẩy) được duyệt
# SAU KHI bấm link xác minh email; chỉ có tác dụng khi REQUIRE_EMAIL_VERIFICATION="true".
TEACHER_AUTO_APPROVE_DOMAINS=""
# Production (Resend): SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<API key re_...>
# SMTP_USER=""
# SMTP_PASS=""
# Hạn mức email/ngày (Resend free: 100; 0 = không giới hạn) và phần dành cho email nhắc việc
EMAIL_DAILY_LIMIT=0
EMAIL_REMINDER_SHARE=0.7

# Job định kỳ: /api/cron và /api/keepalive yêu cầu header Authorization: Bearer <CRON_SECRET>
CRON_SECRET="dev-cron-secret-thay-bang-chuoi-ngau-nhien"
# Header chứa IP thật khi chạy sau proxy (vd "cf-connecting-ip"). Để trống trên Vercel.
CLIENT_IP_HEADER=""

# Third-party Services (Tùy chọn ở local dev)
# RESEND_API_KEY="re_123456789"
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Localization & Timezone
TZ_DISPLAY="Asia/Ho_Chi_Minh"

# Mật khẩu cho tài khoản mẫu khi chạy pnpm db:seed (chỉ dev)
SEED_PASSWORD="matkhau-dev-123"

# Quét virus (clamd). Bỏ trống CLAMAV_HOST để tắt quét (chỉ nên tắt ở dev)
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310

# Web Push (nhắc HS trên điện thoại, kể cả không có email). Tạo cặp khóa: npx web-push generate-vapid-keys
# Để trống thì tắt Web Push (ẩn nút bật thông báo).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
# Email nhận báo khi GV gửi yêu cầu mở khóa tính năng nâng cao (ngoài email của các admin), cách nhau bằng dấu phẩy
ADMIN_NOTIFY_EMAILS=""
